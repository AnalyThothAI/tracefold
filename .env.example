# Optional Compose transport settings only. Copy to .env to persist local choices.
# Business settings and credentials remain in TRACEFOLD_HOME/config.yaml and secret files.
# Shell environment / explicit Make variables override this file.
COMPOSE_PROJECT_NAME=tracefold
TRACEFOLD_HOME=${HOME}/.tracefold

# For a separate development stack, change BOTH the project and home, plus ports.
# COMPOSE_PROJECT_NAME=tracefold-dev
# TRACEFOLD_HOME=${HOME}/.tracefold-dev
# TRACEFOLD_API_PORT=18765
# TRACEFOLD_WORKERS_PORT=18766
# TRACEFOLD_POSTGRES_PORT=56533
# TRACEFOLD_RABBITMQ_PORT=5673
# TRACEFOLD_RABBITMQ_MGMT_PORT=15673

# Published ports bind to loopback by default. Keep database/broker ports private.
# TRACEFOLD_API_HOST=127.0.0.1
